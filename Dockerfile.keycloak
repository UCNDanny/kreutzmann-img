ARG JAVA_IMAGE=gcr.io/distroless/java21-debian13:nonroot@sha256:5a98faeeedb4159dcebf85c1331762b13b5b57dac1cac20ca82ba79b681402f4
ARG UBI_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.7@sha256:907b68736aa798b2d38255b7aa070b2a70acb90803864a40f05d0ec47556ddd0
ARG CA_IMAGE=docker.io/library/alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2
ARG GO_IMAGE=docker.io/library/golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
FROM --platform=$BUILDPLATFORM ${CA_IMAGE} AS ca
RUN test -s /etc/ssl/certs/ca-certificates.crt

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS healthcheck
ARG GOFIPS140
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY scripts/healthcheck/ /src/
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFIPS140=${GOFIPS140} \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/healthcheck . \
    && go version -m /out/healthcheck > /out/healthcheck-build-info.txt

FROM ${JAVA_IMAGE} AS runtime-base

FROM ${UBI_IMAGE} AS build
ARG TARGETARCH
ARG SOURCE_URL
ARG SOURCE_SHA256
ARG BC_FIPS_URL
ARG BC_FIPS_SHA256
ARG BCTLS_FIPS_URL
ARG BCTLS_FIPS_SHA256
ARG BCPKIX_FIPS_URL
ARG BCPKIX_FIPS_SHA256
ARG BCUTIL_FIPS_URL
ARG BCUTIL_FIPS_SHA256
RUN microdnf install -y --setopt=install_weak_deps=0 java-21-openjdk-devel tar gzip && microdnf clean all
RUN fetch() { curl -fsSL --proto '=https' --tlsv1.2 -o "$3" "$1" && echo "$2  $3" | sha256sum -c -; } \
    && fetch "${SOURCE_URL}" "${SOURCE_SHA256}" /tmp/keycloak.tar.gz \
    && mkdir -p /opt/keycloak && tar -xzf /tmp/keycloak.tar.gz --strip-components=1 -C /opt/keycloak \
    && mkdir -p /opt/keycloak/providers \
    && fetch "${BC_FIPS_URL}" "${BC_FIPS_SHA256}" /opt/keycloak/providers/bc-fips.jar \
    && fetch "${BCTLS_FIPS_URL}" "${BCTLS_FIPS_SHA256}" /opt/keycloak/providers/bctls-fips.jar \
    && fetch "${BCPKIX_FIPS_URL}" "${BCPKIX_FIPS_SHA256}" /opt/keycloak/providers/bcpkix-fips.jar \
    && fetch "${BCUTIL_FIPS_URL}" "${BCUTIL_FIPS_SHA256}" /opt/keycloak/providers/bcutil-fips.jar
# Stable provider mtimes prevent optimized-start rebuild detection after COPY.
RUN chmod 0644 /opt/keycloak/providers/*.jar \
    && touch -m --date=@1700000000 /opt/keycloak/providers/*.jar
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true KC_FEATURES=fips KC_FIPS_MODE=strict
COPY dependencies.lock.json /tmp/dependencies.lock.json
COPY scripts/keycloak-security-updates.py /tmp/keycloak-security-updates.py
RUN python3 /tmp/keycloak-security-updates.py
COPY --from=runtime-base /var/lib/dpkg/status.d /tmp/base-status.d
COPY scripts/debian-security-updates.py /tmp/debian-security-updates.py
RUN python3 /tmp/debian-security-updates.py
RUN /opt/keycloak/bin/kc.sh build

COPY scripts/KeycloakLauncher.java /tmp/KeycloakLauncher.java
RUN javac -d /opt/keycloak/lib /tmp/KeycloakLauncher.java \
    && mkdir -p /opt/keycloak/data \
    && chown -R 1000:1000 /opt/keycloak/data \
    && chmod -R go-w /opt/keycloak \
    && rm -rf /opt/keycloak/bin

FROM ${JAVA_IMAGE}
ARG VERSION
COPY --from=build /opt/debian-security-updates/ /
COPY --from=build /opt/keycloak /opt/keycloak
COPY scripts/keycloak-java.options /opt/keycloak/conf/java.options
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/public-ca-bundle.pem
COPY --from=healthcheck --chmod=0555 /out/healthcheck /usr/bin/healthcheck
COPY --from=healthcheck /out/healthcheck-build-info.txt /usr/share/ourimageshardened/healthcheck-build-info.txt
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true \
    KC_FEATURES=fips KC_FIPS_MODE=strict KC_RUN_IN_CONTAINER=true \
    HEALTHCHECK_URL=http://127.0.0.1:9000/health/ready
USER 1000:1000
WORKDIR /opt/keycloak
EXPOSE 8080 9000
LABEL org.opencontainers.image.title="keycloak" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 CMD ["/usr/bin/healthcheck"]
ENTRYPOINT ["/usr/bin/java", "@/opt/keycloak/conf/java.options", "-cp", "/opt/keycloak/lib:/opt/keycloak/lib/quarkus-run.jar", "KeycloakLauncher"]
CMD ["start", "--optimized"]
