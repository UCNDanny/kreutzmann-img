# Copy to .env for Compose. In Railway set individual service variables.
# Deploy published images by digest. Local tags below are for testing only.
OAUTH2_PROXY_IMAGE=kreutzmann-img/oauth2-proxy:local
KEYCLOAK_IMAGE=kreutzmann-img/keycloak:local
# Public HTTPS URLs and client settings from your existing Keycloak realm.
KC_HOSTNAME=
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_REDIRECT_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_SCOPE=openid profile email groups
# Optional regex for API routes that should return 401 instead of redirecting.
OAUTH2_PROXY_API_ROUTES=
# Match the client secret configured in Keycloak. Generate: openssl rand -hex 32
OAUTH2_PROXY_CLIENT_SECRET=
# Preserve the WHOLE output: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=
OAUTH2_PROXY_ALLOWED_GROUPS=
# Railway private domains work only inside the appropriate Railway environment.
OAUTH2_PROXY_UPSTREAMS=
# JDBC, not postgres://. Supply a matching certificate hostname and trusted CA.
KC_DB_URL=jdbc:postgresql://DATABASE_HOST:5432/keycloak?sslmode=verify-full&sslrootcert=/tmp/database-ca.pem
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
# Public CA certificates are included and deployed automatically by the image.
# Only private-CA deployments need DATABASE_CA_PEM supplied by their environment.
# Initial bootstrap only. Use >=14-character random passwords in strict FIPS mode.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
