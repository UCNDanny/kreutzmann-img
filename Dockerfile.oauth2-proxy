# Build through scripts/dependencies.py so all ARGs come from the reviewed lock.
ARG GO_IMAGE=docker.io/library/golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d
ARG STATIC_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
ARG CA_IMAGE=docker.io/library/alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
FROM --platform=$BUILDPLATFORM ${CA_IMAGE} AS ca
# Alpine's base supplies ca-certificates-bundle; no mutable apk install is needed.
RUN test -s /etc/ssl/certs/ca-certificates.crt

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG VERSION
ARG SOURCE_URL
ARG SOURCE_SHA256
ARG GOFIPS140
ARG CRYPTO_VERSION
ARG GRPC_VERSION
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
ADD --checksum=sha256:${SOURCE_SHA256} ${SOURCE_URL} /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src
# Apply reviewed security updates while retaining Go checksum-database validation.
RUN go get golang.org/x/crypto@${CRYPTO_VERSION} google.golang.org/grpc@${GRPC_VERSION} \
    && go mod download && go mod verify
RUN export GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFIPS140=${GOFIPS140}; \
    go build -trimpath -buildvcs=false \
    -ldflags="-s -w -X github.com/oauth2-proxy/oauth2-proxy/v7/pkg/version.VERSION=v${VERSION}" \
    -o /out/oauth2-proxy . \
    && go version -m /out/oauth2-proxy > /out/build-info.txt \
    && go list -deps . > /out/packages.txt \
    && test -s /out/packages.txt \
    && awk '/^golang.org\/x\/crypto\/openpgp(\/|$)/ { print "OpenPGP imported: remove the GO-2026-5932 exclusion"; bad=1 } END { exit bad }' /out/packages.txt

FROM ${STATIC_IMAGE}
ARG VERSION
COPY --from=build --chmod=0555 /out/oauth2-proxy /bin/oauth2-proxy
COPY --from=build /out/build-info.txt /usr/share/ourimageshardened/build-info.txt
COPY --from=build /out/packages.txt /usr/share/ourimageshardened/packages.txt
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Fixed unprivileged identity, independent of deployment defaults.
USER 65532:65532
EXPOSE 4180
LABEL org.opencontainers.image.title="oauth2-proxy" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT"
# No shell or executable healthcheck is added to the runtime.
ENTRYPOINT ["/bin/oauth2-proxy"]
