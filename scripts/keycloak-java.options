-Dkc.home.dir=/opt/keycloak
-Djboss.server.config.dir=/opt/keycloak/conf
-Djava.util.logging.manager=org.jboss.logmanager.LogManager
-Dpicocli.disable.closures=true
-Dquarkus-log-max-startup-records=10000
-Djava.util.concurrent.ForkJoinPool.common.threadFactory=io.quarkus.bootstrap.forkjoin.QuarkusForkJoinWorkerThreadFactory
-XX:MetaspaceSize=96M
-XX:MaxMetaspaceSize=256m
-XX:MaxRAMPercentage=70
-XX:MinRAMPercentage=70
-XX:InitialRAMPercentage=50
-XX:+ExitOnOutOfMemoryError
-XX:+UseG1GC
-XX:FlightRecorderOptions=stackdepth=512
-Dfile.encoding=UTF-8
-Dsun.stdout.encoding=UTF-8
-Dsun.err.encoding=UTF-8
-Dstdout.encoding=UTF-8
-Dstderr.encoding=UTF-8
-Djava.security.egd=file:/dev/urandom
# BCFIPS's supported Java implementation avoids extracting executable JNI to /tmp.
-Dorg.bouncycastle.native.cpu_variant=java
-Djdk.tls.rejectClientInitiatedRenegotiation=true
-Duser.language=en
-Duser.country=US
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
--add-opens=java.base/java.security=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--enable-native-access=ALL-UNNAMED
