# Build through scripts/dependencies.py so all ARGs come from the reviewed lock.
ARG GO_IMAGE=docker.io/library/golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0
ARG STATIC_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
ARG CA_IMAGE=docker.io/library/alpine:3.23@sha256:f3d55900449227ae9e237ede521e7b665d53a253b42065ba90b9db9275e198ad
FROM --platform=$BUILDPLATFORM ${CA_IMAGE} AS ca
# Alpine's base supplies ca-certificates-bundle; no mutable apk install is needed.
RUN test -s /etc/ssl/certs/ca-certificates.crt

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG VERSION
ARG COMMIT
ARG SOURCE_URL
ARG SOURCE_SHA256
ARG GOFIPS140
ARG CRYPTO_VERSION
ARG GRPC_VERSION
ARG JOSE_VERSION
ARG NET_VERSION
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
ADD --checksum=sha256:${SOURCE_SHA256} ${SOURCE_URL} /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src
# Apply reviewed security updates while retaining Go checksum-database validation.
RUN go get golang.org/x/crypto@${CRYPTO_VERSION} golang.org/x/net@${NET_VERSION} google.golang.org/grpc@${GRPC_VERSION} \
        github.com/go-jose/go-jose/v4@${JOSE_VERSION} \
    && go mod download && go mod verify
# No `ui` build tag, so the web console is not compiled in.
RUN export GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFIPS140=${GOFIPS140}; \
    go build -trimpath -buildvcs=false \
    -ldflags="-s -w -X github.com/openbao/openbao/v2/internal/version.fullVersion=${VERSION} -X github.com/openbao/openbao/v2/internal/version.GitCommit=${COMMIT}" \
    -o /out/bao . \
    && go version -m /out/bao > /out/build-info.txt \
    && go list -deps . > /out/packages.txt \
    && test -s /out/packages.txt \
    && awk '/^golang.org\/x\/crypto\/openpgp(\/|$)/ { print "OpenPGP imported: remove the GO-2026-5932 exclusion"; bad=1 } END { exit bad }' /out/packages.txt \
    && mkdir /out/data

FROM ${STATIC_IMAGE}
ARG VERSION
COPY --from=build --chmod=0555 /out/bao /usr/bin/bao
COPY --from=build /out/build-info.txt /usr/share/ourimageshardened/build-info.txt
COPY --from=build /out/packages.txt /usr/share/ourimageshardened/packages.txt
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# Integrated storage lives here; a volume mounted on it starts owned by the runtime user.
COPY --from=build --chown=65532:65532 --chmod=0700 /out/data /openbao/data
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Fixed unprivileged identity, independent of deployment defaults.
USER 65532:65532
EXPOSE 8200 8201
LABEL org.opencontainers.image.title="openbao" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MPL-2.0"
# No shell or executable healthcheck is added to the runtime. No dev-mode default:
# the server needs a mounted configuration.
ENTRYPOINT ["/usr/bin/bao"]
CMD ["server", "-config=/openbao/config"]
