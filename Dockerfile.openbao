# Build through scripts/dependencies.py so all ARGs come from the reviewed lock.
ARG GO_IMAGE=docker.io/library/golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
ARG STATIC_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931
ARG CA_IMAGE=docker.io/library/alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2
FROM --platform=$BUILDPLATFORM ${CA_IMAGE} AS ca
# Alpine's base supplies ca-certificates-bundle; no mutable apk install is needed.
RUN test -s /etc/ssl/certs/ca-certificates.crt

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG VERSION
ARG COMMIT
ARG SOURCE_URL
ARG SOURCE_SHA256
ARG GOFIPS140
ARG CRYPTO_VERSION
ARG GRPC_VERSION
ARG JOSE_VERSION
ARG NET_VERSION
ARG OTEL_VERSION
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
RUN curl -fsSL --proto '=https' --tlsv1.2 -o /tmp/source.tar.gz "${SOURCE_URL}" \
    && echo "${SOURCE_SHA256}  /tmp/source.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src
# Apply reviewed security updates while retaining Go checksum-database validation.
RUN go get golang.org/x/crypto@${CRYPTO_VERSION} golang.org/x/net@${NET_VERSION} google.golang.org/grpc@${GRPC_VERSION} \
        github.com/go-jose/go-jose/v4@${JOSE_VERSION} \
        go.opentelemetry.io/otel@${OTEL_VERSION} go.opentelemetry.io/otel/sdk@${OTEL_VERSION} go.opentelemetry.io/otel/trace@${OTEL_VERSION} \
    && go mod download && go mod verify
# No `ui` build tag, so the web console is not compiled in.
RUN export GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFIPS140=${GOFIPS140}; \
    go build -trimpath -buildvcs=false \
    -ldflags="-s -w -X github.com/openbao/openbao/v2/internal/version.fullVersion=${VERSION} -X github.com/openbao/openbao/v2/internal/version.GitCommit=${COMMIT}" \
    -o /out/bao . \
    && go version -m /out/bao > /out/build-info.txt \
    && go list -deps . > /out/packages.txt \
    && test -s /out/packages.txt \
    && awk '/^golang.org\/x\/crypto\/openpgp(\/|$)/ { print "OpenPGP imported: remove the GO-2026-5932 exclusion"; bad=1 } END { exit bad }' /out/packages.txt \
    && mkdir /out/data

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS healthcheck
ARG GOFIPS140
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY scripts/healthcheck/ /src/
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFIPS140=${GOFIPS140} \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/healthcheck . \
    && go version -m /out/healthcheck > /out/healthcheck-build-info.txt

FROM ${STATIC_IMAGE}
ARG VERSION
COPY --from=build --chmod=0555 /out/bao /usr/bin/bao
COPY --from=healthcheck --chmod=0555 /out/healthcheck /usr/bin/healthcheck
COPY --from=healthcheck /out/healthcheck-build-info.txt /usr/share/ourimageshardened/healthcheck-build-info.txt
COPY --from=build /out/build-info.txt /usr/share/ourimageshardened/build-info.txt
COPY --from=build /out/packages.txt /usr/share/ourimageshardened/packages.txt
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# Integrated storage lives here; a volume mounted on it starts owned by the runtime user.
COPY --from=build --chown=65532:65532 --chmod=0700 /out/data /openbao/data
# Healthy when unsealed (active or standby); a sealed server reports unhealthy.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    HEALTHCHECK_URL=http://127.0.0.1:8200/v1/sys/health?standbyok=true
# Fixed unprivileged identity, independent of deployment defaults.
USER 65532:65532
EXPOSE 8200 8201
LABEL org.opencontainers.image.title="openbao" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MPL-2.0"
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/usr/bin/healthcheck"]
# No dev-mode default: the server needs a mounted configuration.
ENTRYPOINT ["/usr/bin/bao"]
CMD ["server", "-config=/openbao/config"]
